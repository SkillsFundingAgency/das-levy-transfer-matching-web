@{
    ViewData["Title"] = "Find a business to fund training";
    ViewBag.GaData.Vpv = "/find-a-business";
    ViewBag.ZenDeskLabel = "LTM-R-start";
}
<main class="govuk-main-wrapper govuk-main-wrapper--auto-spacing" id="main-content">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <h1 class="govuk-heading-xl">Find a business to fund training</h1>
            <p>Apply for funding from large businesses that want to fund 100% of your costs for apprenticeships or apprenticeship units.</p>
            <p>They can fund your training by transferring some of their growth and skills levy.</p>
            <p>You will need to know the type of training you are applying for transfer funding for.</p>
            <p>You can browse details of funding opportunities and filter to find the most suitable opportunities for your business.</p>

            <div class="govuk-warning-text">
                <span class="govuk-warning-text__icon" aria-hidden="true">!</span>
                <span class="govuk-warning-text__assistive">
                    <span class="govuk-visually-hidden">Warning</span>
                    <p class="govuk-warning-text__text">You'll need an Apprenticeship service account to apply for funding.</p>
                </span>
            </div>
            <div class="govuk-inset-text">
                <p>
                    Read more detailed information about how <a href="https://www.gov.uk/guidance/transferring-apprenticeship-service-funds" target="_blank"
                                                            rel="noopener" class="govuk-link">
                    large businesses transfer their levy funds to other organisations
                </a>.
            </p>
            <p>
                <a href="https://www.gov.uk/guidance/manage-apprenticeship-funds" target="_blank" rel="noopener"
                   class="govuk-link">Register for an Apprenticeship service account.</a>
            </p>
        </div>
        <a asp-controller="opportunities" role="button"
           class="govuk-button govuk-button--start govuk-!-margin-top-5">
            Start now
            <svg class="govuk-button__start-icon" xmlns="http://www.w3.org/2000/svg" width="17.5" height="19"
                 viewBox="0 0 33 40" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M0 0h13l20 20-20 20H0l20-20z" />
            </svg>
        </a>
    </div>
</div>
</main>